#! @SHELL@
set -e
LIBC_FATAL_STDERR_=1
export LIBC_FATAL_STDERR_
[ x"@MPI_LAUNCH@" != xtrue ] || exit 77
@abs_top_builddir@/libtool --mode=execute \
  @MPI_LAUNCH@ -n 3 @abs_builddir@/test_xmap_intersection_parallel
@abs_top_builddir@/libtool --mode=execute \
  @MPI_LAUNCH@ -n 3 @abs_builddir@/test_xmap_intersection_parallel \
  -m xt_xmap_intersection_ext_new
@with_fortran_TRUE@@abs_top_builddir@/libtool --mode=execute \
@with_fortran_TRUE@  @MPI_LAUNCH@ -n 3 @abs_builddir@/test_xmap_intersection_parallel_f
@with_fortran_TRUE@@abs_top_builddir@/libtool --mode=execute \
@with_fortran_TRUE@  @MPI_LAUNCH@ -n 3 @abs_builddir@/test_xmap_intersection_parallel_f \
@with_fortran_TRUE@  -m xt_xmap_intersection_ext_new
#
# Local Variables:
# mode: sh
# End:
#
