#! @SHELL@
set -e
LIBC_FATAL_STDERR_=1
export LIBC_FATAL_STDERR_
[ x"@MPI_LAUNCH@" != xtrue ] || exit 77
for nproc in 2 3 4 8 ; do
  @abs_top_builddir@/libtool --mode=execute \
    @MPI_LAUNCH@ -n $nproc @abs_builddir@/test_xmap_dist_dir_intercomm_parallel
  @with_fortran_TRUE@@abs_top_builddir@/libtool --mode=execute \
  @with_fortran_TRUE@  @MPI_LAUNCH@ -n $nproc @abs_builddir@/test_xmap_dist_dir_intercomm_parallel_f
done
#
# Local Variables:
# mode: sh
# End:
#
