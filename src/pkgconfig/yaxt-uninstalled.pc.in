abs_top_builddir=@abs_top_builddir@
objdir=@lt_cv_objdir@
libdir=${abs_top_builddir}/src/${objdir}
includedir=${abs_top_builddir}/inst_headers/f90

Name: yaxt
Description: Distributed memory data (re-)distribution library.
URL: @PACKAGE_URL@
Version: @VERSION@
Requires:
Libs: -L${libdir} -lyaxt -lyaxt_c
Cflags: @FC_MOD_FLAG@${includedir}
